APP_ENV=local
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/ai_document
STORAGE_ROOT=uploads
JWT_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# Chunk splitter sizes are character counts (not tokens).
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=64
RAG_TOP_K=5
# Reclaim Celery jobs stuck in "running" after a worker crash.
JOB_STALE_MINUTES=30
# Beat reaper: re-enqueue abandoned PENDING, then fail if still stuck.
JOB_PENDING_REENQUEUE_MINUTES=5
JOB_PENDING_FAIL_MINUTES=120
JOB_REAPER_INTERVAL_SECONDS=60
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10
