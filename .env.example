# Copy to .env and fill in production values before `docker compose up`.
# Never commit the real .env file.

# --- Compose / images ---
IMAGE_TAG=latest
# Host interface + port for the web container publish.
# Localhost only (default): WEB_BIND_HOST=127.0.0.1
# All interfaces:           WEB_BIND_HOST=0.0.0.0
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8080
APP_ENV=production

# Public origin browsers use (CORS + cookie context). Must match how users open the app.
# Local Compose on port 80:  http://localhost
# Local Compose on 8080:     http://localhost:8080
# Real deploy:               https://docs.example.com
FRONTEND_URL=http://localhost

# Build-time SPA API base (same-origin behind nginx is recommended).
VITE_API_URL=/api/v1

# --- Postgres ---
POSTGRES_USER=aidoc
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=ai_document

# --- Auth (required; must be strong when APP_ENV != local) ---
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32_OUTPUT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
# true behind HTTPS; set false only for plain-http local Compose.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# --- Storage ---
STORAGE_TYPE=local
# STORAGE_ROOT is set in Compose to /data/uploads (named volume).

# --- Embeddings (used when document pipeline is wired) ---
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=
