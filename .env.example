# Copy to .env and fill in production values before `docker compose up`.
# Never commit the real .env file.

# --- Compose / images ---
IMAGE_TAG=latest
# Host interface + port for the web container publish.
# Localhost only (default): WEB_BIND_HOST=127.0.0.1
# All interfaces:           WEB_BIND_HOST=0.0.0.0
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8080
APP_ENV=production

# Public origin browsers use (CORS + cookie context). Must match how users open the app.
# Local Compose on port 80:  http://localhost
# Local Compose on 8080:     http://localhost:8080
# Real deploy:               https://docs.example.com
FRONTEND_URL=http://localhost

# Build-time SPA API base (same-origin behind nginx is recommended).
VITE_API_URL=/api/v1

# --- Postgres ---
POSTGRES_USER=aidoc
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=ai_document

# --- Auth (required; must be strong when APP_ENV != local) ---
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32_OUTPUT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
# true behind HTTPS; set false only for plain-http local Compose.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# --- Storage ---
# STORAGE_ROOT is set in Compose to /data/uploads (named volume).

# --- AI (chat + embeddings follow AI_PROVIDER; vectors always 1536-dim) ---
# Switching AI_PROVIDER on an existing DB requires re-processing documents.
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# Gemini embeddings must support 1536 dims (gemini-embedding-001, not text-embedding-004).
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# To use Gemini instead:
# AI_PROVIDER=gemini
# (set GEMINI_API_KEY; model vars above can stay)

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=64
RAG_TOP_K=5

# --- Jobs / rate limits ---
JOB_STALE_MINUTES=30
JOB_PENDING_REENQUEUE_MINUTES=5
JOB_PENDING_FAIL_MINUTES=120
JOB_REAPER_INTERVAL_SECONDS=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- Celery (Compose overrides host with redis service) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_CONCURRENCY=2
